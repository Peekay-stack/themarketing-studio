<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Heritage Marketing Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0B1729;
    --bg-alt: #0E1A30;
    --surface: rgba(255,255,255,.045);
    --ink: #FFFFFF;
    --soft: #A9B7CC;
    --mute: #77869E;
    --line: rgba(255,255,255,.16);
    --line-soft: rgba(255,255,255,.07);
    --orange: #F0561E;
    --shadow: 0 20px 46px -22px rgba(0,0,0,.55);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--soft);
    font-family: 'IBM Plex Sans', -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6; -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .brandmark, .tier, .pc-t { font-family: 'Epilogue', sans-serif; color: var(--ink); letter-spacing: -0.03em; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  a { color: inherit; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 1; }
  @media (max-width: 640px) { .wrap { padding: 0 20px; } }

  header {
    position: sticky; top: 0; z-index: 30;
    background: rgba(11,23,41,0.55); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line-soft);
  }
  header .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 20px; }
  .brandmark { display: flex; align-items: center; gap: 9px; font-weight: 800; font-size: 15.5px; letter-spacing: -0.01em; white-space: nowrap; color: var(--ink); }
  .brandmark svg { width: 16px; height: 16px; flex: none; }
  nav.top { display: flex; gap: 8px; font-weight: 600; font-size: 14px; }
  nav.top a { padding: 8px 13px; border-radius: 8px; text-decoration: none; color: var(--soft); }
  nav.top a:hover { background: rgba(255,255,255,.06); color: var(--ink); }
  @media (max-width: 760px) { nav.top { display: none; } }
  .hdr-actions { display: flex; align-items: center; gap: 16px; flex: none; }
  .cta-btn {
    background: var(--orange); color: #fff; border: none; border-radius: 999px;
    padding: 10px 20px; font-weight: 700; font-size: 13.5px; cursor: pointer; text-decoration: none;
    display: inline-block; white-space: nowrap; transition: transform .15s ease;
    box-shadow: 0 0 28px rgba(240,86,30,.38);
  }
  .cta-btn:hover { transform: translateY(-1px); }
  .signin-link { font-weight: 700; font-size: 13.5px; text-decoration: none; color: var(--soft); white-space: nowrap; }
  .signin-link:hover { color: var(--ink); }

  /* ---------- hero ---------- */
  .hero { padding: 72px 0 20px; position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      repeating-linear-gradient(45deg, rgba(240,86,30,.09) 0 1.5px, transparent 1.5px 42px),
      repeating-linear-gradient(-45deg, rgba(255,255,255,.08) 0 1.5px, transparent 1.5px 42px);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 88%);
    mask-image: linear-gradient(to bottom, black, transparent 88%);
  }
  .hero::after {
    content: ''; position: absolute; top: -160px; right: -160px; width: 720px; height: 720px;
    border-radius: 50%; z-index: 0; pointer-events: none;
    background: radial-gradient(circle, rgba(46,94,166,.4), transparent 70%);
  }
  .hero .glow-2 {
    position: absolute; bottom: -180px; left: -140px; width: 520px; height: 520px; border-radius: 50%;
    z-index: 0; pointer-events: none; background: radial-gradient(circle, rgba(240,86,30,.16), transparent 70%);
  }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; position: relative; z-index: 1; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }
  .eyebrow { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; color: var(--mute); margin-bottom: 18px; display: flex; align-items: center; }
  .eyebrow .diam { width: 8px; height: 8px; margin-right: 9px; flex: none; }
  .eyebrow .dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--orange); margin-right:9px; vertical-align:1px; }
  h1.display {
    font-size: clamp(34px, 4.4vw, 50px); font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.05; margin: 0 0 20px; text-wrap: balance; color: var(--ink);
  }
  h1.display .hl { color: var(--orange); }
  .lede { font-size: 16.5px; color: var(--soft); max-width: 480px; margin: 0 0 30px; text-wrap: pretty; }
  .hero-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .hero-actions .ghost {
    border: 1.5px solid var(--line); color: var(--ink); border-radius: 999px;
    padding: 9px 20px; font-size: 13.5px; font-weight: 700; text-decoration: none; background: transparent;
  }

  .hero-visual { position: relative; height: 380px; z-index: 1; }
  .hv-card {
    position: absolute; border-radius: 14px; box-shadow: var(--shadow); overflow: hidden;
    border: 1px solid var(--line); background: var(--surface); backdrop-filter: blur(14px);
  }
  .hv-social { width: 190px; height: 240px; top: 6px; left: 18px; z-index: 3; }
  .hv-social .hv-top { height: 34px; background: var(--surface); display: flex; align-items: center; gap: 6px; padding: 0 10px; border-bottom: 1px solid var(--line-soft); }
  .hv-social .hv-dot { width: 18px; height: 18px; border-radius: 50%; background: linear-gradient(135deg,#2E5EA6,#6E9FE0); flex: none; }
  .hv-social .hv-line { height: 6px; border-radius: 3px; background: rgba(255,255,255,.12); }
  .hv-social .hv-body { height: 150px; background: linear-gradient(160deg,rgba(46,94,166,.30),rgba(23,50,94,.55)); position: relative; }
  .hv-social .hv-body::after { content:''; position:absolute; inset:26px; border-radius:10px; background:linear-gradient(135deg,#2E5EA6,#9DB8E0); opacity:.22; }
  .hv-social .hv-foot { padding: 10px; display: flex; gap: 6px; }
  .hv-pos {
    width: 150px; height: 190px; top: 130px; right: 6px; z-index: 2;
    background: linear-gradient(160deg,rgba(240,86,30,.22),rgba(240,86,30,.10)); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
  }
  .hv-pos .hv-tag { font-size:9.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#E8A67C; }
  .hv-pos .hv-glyph { width:46px; height:46px; }
  .hv-onground {
    width: 168px; height: 108px; bottom: 10px; left: 60px; z-index: 4;
    background: linear-gradient(160deg,rgba(30,92,74,.30),rgba(30,92,74,.52)); padding: 14px;
  }
  .hv-onground .hv-pin { font-size: 20px; margin-bottom: 6px; }
  .hv-onground .hv-t { font-size: 11.5px; font-weight: 700; color: #7FD9B8; margin-bottom: 3px; }
  .hv-onground .hv-d { font-size: 10px; color: #A6E3CB; line-height: 1.4; }
  .hv-video {
    width: 170px; height: 128px; top: 30px; right: 40px; z-index: 1;
    background: linear-gradient(160deg,rgba(74,46,92,.34),rgba(74,46,92,.56)); padding: 12px; display:flex; flex-direction:column; justify-content:space-between;
  }
  .hv-video .hv-frames { display:flex; gap:4px; }
  .hv-video .hv-frames span { flex:1; height:38px; border-radius:5px; background:rgba(199,159,224,.30); }
  .hv-video .hv-t { font-size: 11px; font-weight:700; color:#D2AAE8; }

  /* ---------- marquee ---------- */
  .marquee-wrap { padding: 46px 0; border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); overflow: hidden; position: relative; z-index: 1; background: var(--bg); }
  .lane { display: flex; gap: 14px; width: max-content; }
  .lane + .lane { margin-top: 14px; }
  .lane.left { animation: scrollLeft 32s linear infinite; }
  .lane.right { animation: scrollRight 32s linear infinite; }
  .marquee-wrap:hover .lane { animation-play-state: paused; }
  @keyframes scrollLeft { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes scrollRight { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .lane.left, .lane.right { animation: none; } }
  .chip {
    flex: none; background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
    padding: 10px 18px; font-size: 13px; font-weight: 600; color: var(--soft); white-space: nowrap;
    display: flex; align-items: center; gap: 8px; box-shadow: var(--shadow); backdrop-filter: blur(14px);
  }
  .chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); flex: none; }

  /* ---------- section shared ---------- */
  section { padding: 84px 0; scroll-margin-top: 84px; position: relative; z-index: 1; }
  .shead { max-width: 620px; margin-bottom: 44px; }
  .shead .eyebrow { margin-bottom: 12px; }
  .shead h2 { font-size: clamp(26px, 3.2vw, 34px); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 12px; text-wrap: balance; color: var(--ink); }
  .shead p { font-size: 15.5px; color: var(--soft); margin: 0; }

  .stages { display: flex; gap: 0; overflow-x: auto; padding-bottom: 6px; margin-bottom: 8px; }
  .stage { flex: 1; min-width: 168px; position: relative; padding: 0 22px 0 0; }
  .stage:not(:last-child)::after { content: '→'; position: absolute; right: 2px; top: 0; color: var(--line); font-size: 16px; }
  .stage .sn { font-size: 10.5px; font-weight: 700; color: var(--mute); margin-bottom: 6px; }
  .stage .st { font-weight: 700; font-size: 14px; margin-bottom: 4px; color: var(--ink); }
  .stage .sd { font-size: 12px; color: var(--soft); line-height: 1.5; }
  .producers-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 34px; }
  @media (max-width: 760px) { .producers-row { grid-template-columns: 1fr 1fr; } }
  .producer { border-radius: 14px; padding: 20px 18px; color: #fff; min-height: 118px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow); }
  .producer .pc-t { font-size: 15px; font-weight: 700; color: #fff; }
  .producer .pc-d { font-size: 12px; opacity: .88; line-height: 1.5; margin-top: 6px; }

  .uc-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; }
  @media (max-width: 900px) { .uc-grid { grid-template-columns: 1fr 1fr; } }
  .uc-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); backdrop-filter: blur(14px); }
  .uc-visual { height: 140px; display: flex; align-items: center; justify-content: center; position: relative; }
  .uc-meta { padding: 16px 17px 18px; }
  .uc-meta .uc-tag { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 6px; }
  .uc-meta h4 { margin: 0 0 6px; font-size: 14.5px; font-weight: 700; color: var(--ink); }
  .uc-meta p { margin: 0; font-size: 12.5px; color: var(--soft); line-height: 1.5; }
  .uc-note { margin-top: 18px; font-size: 11.5px; color: var(--mute); }

  .price-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
  @media (max-width: 900px) { .price-grid { grid-template-columns: 1fr 1fr; } }
  .price-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 24px 20px; display: flex; flex-direction: column; box-shadow: var(--shadow); backdrop-filter: blur(14px); }
  .price-card .tier { font-size: 15px; font-weight: 800; margin-bottom: 4px; color: var(--ink); }
  .price-card .who { font-size: 11.5px; color: var(--mute); margin-bottom: 16px; }
  .price-card .amt { font-size: 22px; font-weight: 600; margin-bottom: 2px; color: var(--ink); }
  .price-card .per { font-size: 10.5px; color: var(--mute); margin-bottom: 14px; }
  .price-card .inc { font-size: 12px; line-height: 1.55; color: var(--soft); margin: 0; flex: 1; }
  .price-card .setup { font-size: 10.5px; color: var(--mute); margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line-soft); }
  .price-quote { margin: 0 0 32px; padding: 16px 22px; border-left: 3px solid var(--orange); background: var(--surface); border-radius: 0 12px 12px 0; font-size: 15.5px; font-weight: 700; max-width: 620px; box-shadow: var(--shadow); color: var(--ink); backdrop-filter: blur(14px); }
  .price-note { margin-top: 22px; font-size: 12.5px; color: var(--soft); max-width: 640px; line-height: 1.6; }

  .demo-panel { background: linear-gradient(135deg, var(--surface), var(--bg-alt)); border: 1px solid var(--line); border-radius: 22px; padding: 48px; color: #F7F5F1; display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; }
  @media (max-width: 860px) { .demo-panel { grid-template-columns: 1fr; padding: 36px 26px; } }
  .demo-panel h2 { color: #fff; font-size: clamp(24px,3vw,32px); font-weight: 800; margin: 0 0 14px; }
  .demo-panel p.lede { color: #C9D6E8; max-width: none; }
  .demo-q { margin-top: 18px; padding: 16px 20px; background: rgba(255,255,255,.06); border-left: 3px solid var(--orange); border-radius: 0 12px 12px 0; font-size: 13.5px; line-height: 1.6; color: #E7EDF6; }
  .demo-form { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .demo-form label { font-size: 10.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #A9B7CC; }
  .demo-form input, .demo-form textarea { font-family: inherit; font-size: 13.5px; padding: 10px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.06); color: #fff; }
  .demo-form input::placeholder, .demo-form textarea::placeholder { color: #7E8CA3; }
  .demo-form button { font-family: inherit; font-weight: 800; font-size: 13.5px; border: none; border-radius: 999px; padding: 13px; cursor: pointer; margin-top: 4px; background: var(--orange); color: #fff; }

  footer { padding: 40px 0 56px; }
  footer .wrap { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .fine { font-size: 12px; color: var(--mute); }
</style>
</head>

# Copy to .env. The app runs fully WITHOUT any of these (mock copy + placeholder creatives).
# Set them to switch on the real thing — no code change needed.

# ANTHROPIC_API_KEY=sk-ant-...        # real copy generation AND the AI "Draft brief with AI"
#                                     # button (runs the brand-brief skill). Required for drafting.
# GEN_MODEL=claude-opus-4-8           # model used for ALL AI (briefs, social, video, campaigns,
#                                     # insights). Default: claude-opus-4-8. Set claude-opus-5 for
#                                     # the strongest option (same price), or claude-sonnet-5 to save cost.
# FAL_KEY=...                          # real image/video via the fal.ai gateway
# DATABASE_URL=sqlite:///./heritage.db # default is local SQLite

# HeyGen avatar/presenter video (Video Studio "Avatar video" mode).
# Without it, avatar generation returns a placeholder; with it, real multilingual avatar videos.
HEYGEN_API_KEY=
